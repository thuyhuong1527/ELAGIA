<section id="about"><div class="about"><div class="aboutBox"><div class="kicker">GÓC NHỎ DÀNH CHO CỘNG ĐỒNG YÊU TRUYỆN</div><h3>Chào mừng đến Elagia Comics ✦</h3><p>Một góc nhỏ dành cho cộng đồng yêu thích Manga, Manhwa và Manhua. Giao diện hướng đến trải nghiệm đọc thoải mái trên máy tính lẫn điện thoại.</p></div><div class="note"><strong style="color:var(--purple2)">Elagia Comics</strong><p>Bản xem trước chỉ mô phỏng giao diện và thao tác cơ bản. Khi tích hợp WordPress, truyện/chương sẽ lấy từ dữ liệu quản trị thật.</p></div></div></section><section id="me" class="personalView"><iframe src="index.html" title="Trang cá nhân Elagia" loading="lazy"></iframe></section></main><footer><div class="wrap footerInner"><span>© Elagia Comics · READ · DREAM · REPEAT</span><span>Pastel purple × black</span></div></footer><div class="modal" id="modal" role="dialog" aria-modal="true"><div class="modalBox"><div class="modalTop"><div class="kicker">COMIC DETAILS</div><button class="close" id="closeModal">Đóng ✕</button></div><div id="modalContent"></div><div class="chapterLinks" id="chapterLinks"></div><div class="reader" id="reader"><div class="fakePage"><div><div style="font-size:12px;letter-spacing:.15em">ELAGIA COMICS · DEMO</div><h3 id="readerTitle">Chương 1</h3><p>Đây là khu vực minh họa trình đọc chương. Khi kết nối WordPress, nội dung thật sẽ hiển thị tại đây.</p></div></div><div class="readerNav"><button class="chip" id="prevChapter">← Chương trước</button><button class="chip" id="nextChapter">Chương sau →</button></div></div></div></div><div class="toast" id="toast"></div><script>
const comics=[
{title:'Moonlit Garden',genre:'Manhwa',tags:['Fantasy','Romance'],desc:'Một khu vườn bí ẩn mở ra khi trăng lên. Hành trình bắt đầu từ một lời hứa.',chapters:24},
{title:'The Violet Crown',genre:'Manhua',tags:['Fantasy','Action'],desc:'Thiếu nữ thừa kế chiếc vương miện tím và bí mật của vương quốc.',chapters:18},
{title:'Cat Café Days',genre:'Manga',tags:['Comedy','Romance'],desc:'Những ngày bình yên ở quán cà phê mèo nhỏ trong con phố cũ.',chapters:42},
{title:'After the Rain',genre:'Manhwa',tags:['Romance'],desc:'Hai người xa lạ gặp lại nhau sau một mùa mưa dài.',chapters:31},
{title:'Starbound Academy',genre:'Manhua',tags:['Fantasy','Action'],desc:'Học viện phép thuật nơi mỗi vì sao cất giữ một sức mạnh riêng.',chapters:16},
{title:'Little Fox Diary',genre:'Manga',tags:['Comedy'],desc:'Nhật ký đáng yêu của một chú cáo nhỏ và nhóm bạn tinh nghịch.',chapters:12},
{title:'Crimson Echo',genre:'Manhwa',tags:['Action','Fantasy'],desc:'Một lời nguyền cổ đại buộc chiến binh trẻ tìm lại ký ức đã mất.',chapters:27},
{title:'Blooming Season',genre:'Manhua',tags:['Romance'],desc:'Một câu chuyện nhẹ nhàng về tình bạn và những khởi đầu mới.',chapters:20}
];
const genreChoices=[
['Shounen','Shounen'],['Shoujo','Shoujo'],['Seinen','Seinen'],['Josei','Josei'],['Kodomo','Kodomo'],
['Hành động','Action'],['Phiêu lưu','Adventure'],['Viễn tưởng','Sci-Fi'],['Kỳ ảo','Fantasy'],['Trinh thám','Mystery'],['Giật gân','Thriller'],['Kinh dị','Horror'],['Hài hước','Comedy'],['Thể thao','Sports'],['Học đường','School'],['Lãng mạn','Romance'],['Isekai','Isekai'],['Trọng sinh','Rebirth'],['Hệ thống','System'],['Tu tiên','Cultivation'],['Huyền huyễn','Xuanhuan'],['Harem','Harem']
];
let activeGenre='all',activeComic=null,currentChapter=1;const $=s=>document.querySelector(s);const grid=$('#comicGrid');
const genreOptions=$('#genreOptions');genreChoices.forEach(([label,value])=>{const b=document.createElement('button');b.type='button';b.className='chip';b.textContent=label;b.dataset.genre=value;b.addEventListener('click',()=>{activeGenre=value;document.querySelectorAll('#filters .chip').forEach(x=>x.classList.toggle('active',x.dataset.genre===value));genreOptions.querySelectorAll('.chip').forEach(x=>x.classList.toggle('active',x.dataset.genre===value));render();$('#truyen-moi').scrollIntoView({behavior:'smooth'});});genreOptions.appendChild(b)});
const genreToggle=$('#genreToggle');genreToggle.addEventListener('click',()=>{const opening=genreOptions.hidden;genreOptions.hidden=!opening;genreToggle.setAttribute('aria-expanded',String(opening));$('#genreDetails').classList.toggle('is-open',opening);});
function render(){grid.innerHTML='';let q=$('#searchInput').value.trim().toLowerCase();let arr=comics.filter(c=>(activeGenre==='all'||c.genre===activeGenre||c.tags.includes(activeGenre))&&c.title.toLowerCase().includes(q));if(!arr.length){grid.innerHTML='<div class="content-panel">Không tìm thấy truyện phù hợp. Thử từ khóa khác nhé.</div>';return}arr.forEach((c,i)=>{let card=document.createElement('article');card.className='comic-card';card.innerHTML=`<a class="comic-card-link" href="#comic-${i}"><div class="preview-cover"><div>✦<br>${c.title}<div class="cover-tag">${c.genre.toUpperCase()}</div></div></div><div class="cardBody"><h2>${c.title}</h2><p>${c.chapters} chương · Đang cập nhật</p></div></a><div class="comic-card-actions"><button class="chip favBtn" type="button">♡ Yêu thích</button></div>`;card.querySelector('a').addEventListener('click',e=>{e.preventDefault();openComic(c)});card.querySelector('.favBtn').addEventListener('click',()=>toggleFav(c));grid.appendChild(card)})}
function renderHot(){const hotGrid=$('#hotGrid');if(!hotGrid)return;hotGrid.innerHTML='';const hotTitles=['Moonlit Garden','The Violet Crown','Cat Café Days','Crimson Echo'];hotTitles.forEach(title=>{const c=comics.find(x=>x.title===title);if(!c)return;const card=document.createElement('article');card.className='comic-card';card.innerHTML=`<a class="comic-card-link" href="#hot-${encodeURIComponent(c.title)}"><div class="preview-cover"><div>🔥<br>${c.title}<div class="cover-tag">${c.genre.toUpperCase()}</div></div></div><div class="cardBody"><h2>${c.title}</h2><p>${c.chapters} chương · Đang cập nhật</p></div></a><div class="comic-card-actions"><button class="chip favBtn" type="button">♡ Yêu thích</button></div>`;card.querySelector('a').addEventListener('click',e=>{e.preventDefault();openComic(c)});card.querySelector('.favBtn').addEventListener('click',()=>toggleFav(c));hotGrid.appendChild(card)})}
function toast(t){$('#toast').textContent=t;$('#toast').classList.add('show');setTimeout(()=>$('#toast').classList.remove('show'),1800)}function toggleFav(c){let a=JSON.parse(localStorage.getItem('elagiaFav')||'[]');if(a.some(x=>x.title===c.title)){a=a.filter(x=>x.title!==c.title);toast('Đã bỏ yêu thích')}else{a.push({title:c.title});toast('Đã thêm vào yêu thích')}localStorage.setItem('elagiaFav',JSON.stringify(a));showLists()}function showLists(){let f=JSON.parse(localStorage.getItem('elagiaFav')||'[]'),h=JSON.parse(localStorage.getItem('elagiaHist')||'[]');$('#favList').innerHTML=f.length?f.map(x=>`<button class="chip" data-open="${x.title}">♡ ${x.title}</button>`).join(''):'Chưa có truyện yêu thích.';$('#historyList').innerHTML=h.length?h.map(x=>`<button class="chip" data-open="${x.title}">↗ ${x.title} · Ch.${x.chapter}</button>`).join(''):'Chưa có lịch sử đọc.';document.querySelectorAll('[data-open]').forEach(b=>b.onclick=()=>{let c=comics.find(x=>x.title===b.dataset.open);if(c)openComic(c)})}
function openComic(c){activeComic=c;$('#modalContent').innerHTML=`<div class="preview-cover" style="--c1:#8762a6;--c2:#2a1e3b;width:110px;float:left;margin:0 16px 12px 0;border-radius:10px">✦</div><h2>${c.title}</h2><p>${c.genre} · ${c.tags.join(' · ')}</p><p>${c.desc}</p><p><b>${c.chapters} chương</b> · Đang cập nhật</p><button class="btn" id="readFirst">Đọc chương 1 ↗</button><button class="chip" id="modalFav">♡ Yêu thích</button><div style="clear:both"></div>`;$('#chapterLinks').innerHTML='';for(let n=Math.min(c.chapters,8);n>=1;n--){let b=document.createElement('button');b.innerHTML=`<span>Chương ${n}</span><span>Đọc ngay ↗</span>`;b.onclick=()=>readChapter(n);$('#chapterLinks').appendChild(b)}$('#reader').classList.remove('show');$('#modal').classList.add('open');$('#readFirst').onclick=()=>readChapter(1);$('#modalFav').onclick=()=>toggleFav(c)}function readChapter(n){currentChapter=n;$('#readerTitle').textContent=activeComic.title+' · Chương '+n;$('#reader').classList.add('show');let h=JSON.parse(localStorage.getItem('elagiaHist')||'[]').filter(x=>x.title!==activeComic.title);h.unshift({title:activeComic.title,chapter:n});localStorage.setItem('elagiaHist',JSON.stringify(h.slice(0,6)));showLists();$('#reader').scrollIntoView({behavior:'smooth',block:'nearest'})}$('#prevChapter').onclick=()=>{if(currentChapter>1)readChapter(currentChapter-1);else toast('Đây là chương đầu tiên')};$('#nextChapter').onclick=()=>{if(activeComic&&currentChapter<activeComic.chapters)readChapter(currentChapter+1);else toast('Đây là chương mới nhất trong demo')};$('#closeModal').onclick=()=>$('#modal').classList.remove('open');$('#modal').onclick=e=>{if(e.target===$('#modal'))$('#modal').classList.remove('open')};$('#searchForm').onsubmit=e=>{e.preventDefault();render();$('#truyen-moi').scrollIntoView({behavior:'smooth'})};$('#searchInput').oninput=render;document.querySelectorAll('[data-genre]').forEach(b=>b.onclick=()=>{activeGenre=b.dataset.genre;document.querySelectorAll('#filters .chip').forEach(x=>x.classList.toggle('active',x.dataset.genre===activeGenre));render();$('#truyen-moi').scrollIntoView({behavior:'smooth'})});$('#menuBtn').onclick=()=>$('#navlinks').classList.toggle('open');render();renderHot();showLists();

document.querySelectorAll('.stats .stat').forEach(function(tile){tile.addEventListener('click',function(){var genre=tile.dataset.genre;var filter=document.querySelector('#filters [data-genre=\"'+genre+'\"]');if(filter)filter.click();document.getElementById('truyen-moi').scrollIntoView({behavior:'smooth'});});});
const themeToggle=document.getElementById('themeToggle');const savedTheme=localStorage.getItem('elagiaTheme')||'light';document.documentElement.dataset.theme=savedTheme;function updateThemeButton(){const dark=document.documentElement.dataset.theme==='dark';themeToggle.textContent=dark?'☾ Tối':'☀ Sáng';themeToggle.setAttribute('aria-label',dark?'Chuyển sang giao diện sáng':'Chuyển sang giao diện tối')}updateThemeButton();themeToggle.addEventListener('click',()=>{const next=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=next;localStorage.setItem('elagiaTheme',next);updateThemeButton()});
const forumForm=document.getElementById('forumForm'),forumPosts=document.getElementById('forumPosts');function renderForum(){const posts=JSON.parse(localStorage.getItem('elagiaForumPosts')||'[]');forumPosts.replaceChildren();if(!posts.length){const empty=document.createElement('div');empty.className='forumEmpty';empty.textContent='Chưa có bài viết. Hãy mở đầu cuộc trò chuyện nhé!';forumPosts.appendChild(empty);return}posts.slice().reverse().forEach(post=>{const article=document.createElement('article');article.className='forumPost';const title=document.createElement('h3');title.textContent=post.title;const meta=document.createElement('small');meta.textContent=post.name+' · '+post.date;const body=document.createElement('p');body.textContent=post.body;article.append(title,meta,body);forumPosts.appendChild(article)})}forumForm.addEventListener('submit',event=>{event.preventDefault();const posts=JSON.parse(localStorage.getItem('elagiaForumPosts')||'[]');posts.push({name:document.getElementById('forumName').value.trim(),title:document.getElementById('forumTitle').value.trim(),body:document.getElementById('forumBody').value.trim(),date:new Date().toLocaleString('vi-VN')});localStorage.setItem('elagiaForumPosts',JSON.stringify(posts.slice(-50)));forumForm.reset();renderForum()});renderForum();
const mainView=document.querySelector('main.site-main'),mainNavLinks=[...document.querySelectorAll('.navlinks a')];function switchMainView(href){mainView.classList.toggle('personal-view',href==='#me');mainNavLinks.forEach(link=>{const active=link.getAttribute('href')===href;link.classList.toggle('active',active);if(active)link.setAttribute('aria-current','page');else link.removeAttribute('aria-current')});if(href==='#me'){window.scrollTo({top:0,behavior:'smooth'});document.getElementById('navlinks')?.classList.remove('open')}}mainNavLinks.forEach(link=>link.addEventListener('click',event=>{const href=link.getAttribute('href');switchMainView(href);if(href==='#me'){event.preventDefault();history.replaceState(null,'','#me')}}));if(location.hash==='#me')switchMainView('#me');</script></body></html>