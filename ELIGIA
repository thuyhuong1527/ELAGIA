/* Elagia Comics refinements */
:root{--bg:#100d16;--panel:#1b1624;--panel2:#282035;--line:#40314f;--purple:#c7a0f4;--purple2:#eee2ff;--text:#fbf7ff;--muted:#b9abc9;--pink:#efb9df;--green:#bfe6d0}
html{scroll-padding-top:90px}
::selection{background:#c7a0f4;color:#171020}
:focus-visible{outline:2px solid var(--purple);outline-offset:3px}
button:disabled{opacity:.45;cursor:not-allowed;transform:none}
.brandmark{font-size:20px;box-shadow:0 0 0 1px #ffffff20 inset,0 7px 24px #b58ae933}
.brand{letter-spacing:.045em}
.heroBox{box-shadow:0 22px 70px #0002}
.card{box-shadow:0 8px 22px #00000012}
.card:focus-within,.card:focus{outline:2px solid var(--purple);outline-offset:2px}
.cover{isolation:isolate}
.cover .coverText{overflow-wrap:anywhere}
.chapterLinks button:hover{border-color:var(--purple);background:#342744}
.update:hover,.genre:focus-visible{border-color:var(--purple)}
.modalBox{scrollbar-color:#755b91 #211a2b;scrollbar-width:thin}
.reader .fakePage{line-height:1.8}
.toast{box-shadow:0 8px 28px #0005}
@media(max-width:580px){
  .brandmark{width:38px;height:38px;border-radius:12px}
  .brand{font-size:13px}
  .brand small{font-size:8px}
  .heroBox{border-radius:22px}
  .modalBox{padding:18px;border-radius:18px}
}
@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
}


/* WordPress theme layout */
.wp-site{min-height:100vh}
.site-main{padding-bottom:28px}
.content-panel{background:var(--panel);border:1px solid #ffffff12;border-radius:18px;padding:22px;margin:20px 0}
.entry-content{color:var(--text)}
.entry-content img{max-width:100%;height:auto;border-radius:8px}
.comic-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}
.comic-card{background:var(--panel);border:1px solid #ffffff12;border-radius:17px;overflow:hidden;transition:transform .2s,border-color .2s}
.comic-card:hover{transform:translateY(-4px);border-color:#c9a7f577}
.comic-card a{display:block}
.comic-card img{width:100%;aspect-ratio:3/4;object-fit:cover;display:block}
.comic-placeholder{aspect-ratio:3/4;display:grid;place-items:center;background:linear-gradient(150deg,#9876ba,#3d2b58);font-size:48px;color:#eee2ff}
.comic-card .cardBody{padding:12px}
.comic-card h2{font-size:14px;margin:0;font-weight:850}
.comic-card p{font-size:12px;color:var(--muted);margin:7px 0 0}
.pagination{display:flex;gap:8px;flex-wrap:wrap;margin:22px 0}
.pagination a,.pagination span{padding:8px 12px;border-radius:10px;background:var(--panel2);border:1px solid var(--line)}
.pagination .current{background:var(--purple);color:#241a30}
.reader-images img{display:block;width:100%;height:auto;margin:0 auto;border-radius:0}
.reader-images{max-width:900px;margin:0 auto}
.chapter-nav{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;margin:18px 0}
.chapter-nav a,.text-link{color:var(--purple2);text-decoration:underline;text-underline-offset:3px}
.archive-description{color:var(--muted)}
input[type="search"],input[type="text"],textarea,select{max-width:100%;background:#241d30;border:1px solid var(--line);color:var(--text);border-radius:10px;padding:10px}
.search-form{display:flex;gap:8px}
.search-form label{flex:1;min-width:0}
.search-form input[type="search"]{width:100%}
@media(max-width:800px){.comic-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}}
@media(max-width:580px){.comic-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}.content-panel{padding:16px}.comic-card .cardBody{padding:10px}}

/* Custom logo uploaded from WordPress */
.custom-logo-link{display:flex;align-items:center}.custom-logo{max-width:210px;max-height:58px;width:auto;height:auto;object-fit:contain}.brand .custom-logo-link{display:flex}.brand:has(.custom-logo){gap:0}


/* Elagia Comics 1.2 — account and reader tools */
.account-links{display:flex;gap:10px;align-items:center;white-space:nowrap;font-size:12px;color:var(--muted)}
.account-links a:hover{color:var(--purple2)}
.elagia-reader-tools{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin:16px 0}
.elagia-tool-message{font-size:12px;color:var(--purple2)}
.comment-panel{margin-top:18px}
.comment-panel .comment-form input,.comment-panel .comment-form textarea{width:100%;max-width:100%;padding:11px;border-radius:10px;background:var(--panel2);border:1px solid var(--line);color:var(--text)}
.comment-panel .form-submit input{width:auto;background:var(--purple);color:#241a30;border:0;border-radius:10px;padding:10px 16px;font-weight:800}
#elagia-favorites-list,#elagia-history-list{display:flex;gap:8px;flex-wrap:wrap;color:var(--muted);font-size:13px}
#elagia-favorites-list a,#elagia-history-list a{padding:8px 11px;background:var(--panel2);border:1px solid var(--line);border-radius:10px}
@media(max-width:980px){.account-links{font-size:11px;gap:6px}.nav{flex-wrap:wrap;padding:10px 0}.account-links{margin-left:auto}}
@media(max-width:600px){.account-links{order:3;width:100%;justify-content:flex-end}.search{max-width:none;width:100%;order:4}}

/* Elagia Comics custom E-cat logo */
.elagia-logo-e{width:48px;height:48px;object-fit:contain;display:block;flex:none;border-radius:12px}
@media(max-width:580px){.elagia-logo-e{width:42px;height:42px}}

/* Genre filter */
.genre-filter{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:0 0 18px;padding:14px 16px;background:var(--panel);border:1px solid #ffffff12;border-radius:14px}.genre-filter label{font-size:13px;font-weight:800;color:var(--purple2)}.genre-filter select{background:#211a2b;color:var(--text);border:1px solid var(--line);border-radius:10px;padding:9px 12px;min-width:190px}.genre-filter button{font:inherit}
.genre-toggle{width:100%;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:15px 17px;border:1px solid var(--line);border-radius:15px;background:linear-gradient(120deg,#251c31,#1a1522);color:var(--text);font-weight:850;cursor:pointer;text-align:left}
.genre-toggle span:first-child{display:flex;align-items:center;gap:10px}.genre-toggle .arrow{color:var(--purple);transition:transform .2s}.genre-details.is-open .arrow{transform:rotate(180deg)}
.genre-options{display:flex;flex-wrap:wrap;gap:8px;padding:14px 2px 4px}.genre-options[hidden]{display:none!important}.genre-options .chip{font-size:12px}.genre-options .chip.active{background:var(--purple);color:#241a30}

/* v1.5: ensure comic card links are independently clickable */
.comic-card-link{display:block;position:relative;z-index:1;color:inherit;text-decoration:none;cursor:pointer}.comic-card-actions{position:relative;z-index:2;padding:0 16px 16px}.comic-card-actions button{cursor:pointer}.comic-card-link .cardBody{pointer-events:none}


